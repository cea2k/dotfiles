{{- /* Asked once on `chezmoi init`, then remembered in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $role  := promptChoiceOnce . "role" "Machine role" (list "laptop" "server" "test") -}}
{{- $name  := promptStringOnce . "name" "Git user.name" -}}
{{- $email := promptStringOnce . "email" "Git user.email" -}}

{{- /* age encryption is enabled only if the identity file exists on this machine */ -}}
{{- $ageKey := joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" -}}
{{- $hasAge := and (stat $ageKey) (lookPath "age-keygen") -}}

{{- if $hasAge }}
encryption = "age"
{{- end }}

[data]
role  = {{ $role | quote }}
name  = {{ $name | quote }}
email = {{ $email | quote }}
# Bitwarden-backed secrets render only on the main laptop
secrets = {{ eq $role "laptop" }}
desktop = {{ ne $role "server" }}

{{- if $hasAge }}

[age]
identity  = {{ $ageKey | quote }}
recipient = {{ output "age-keygen" "-y" $ageKey | trim | quote }}
{{- end }}

# Install rbw/age before chezmoi reads the source state (templates need them)
[hooks.read-source-state.pre]
command = "sh"
args = [{{ joinPath .chezmoi.sourceDir ".install-prereqs.sh" | quote }}]

[diff]
exclude = ["scripts"]

[git]
autoCommit = false
autoPush = false
