# Managed by chezmoi. Edit with: chezmoi edit ~/.zshrc
# Machine-only tweaks go in ~/.zshrc.local (not tracked).

# --- History ---------------------------------------------------------------
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
mkdir -p "${HISTFILE:h}"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# --- Basics ----------------------------------------------------------------
setopt AUTO_CD INTERACTIVE_COMMENTS
bindkey -e
autoload -Uz compinit && compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"
export EDITOR=nvim VISUAL=nvim
path=("$HOME/.local/bin" $path)

{{- if eq .chezmoi.osRelease.id "ubuntu" }}

# Debian/Ubuntu ship these under different binary names
alias bat='batcat'
alias fd='fdfind'
{{- end }}

# --- Tools -----------------------------------------------------------------
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v fzf  >/dev/null && source <(fzf --zsh)

{{- if .secrets }}

# --- SSH keys served by Bitwarden desktop (keys never touch the repo) ------
for sock in \
  "$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock" \
  "$HOME/.bitwarden-ssh-agent.sock"; do
  [[ -S "$sock" ]] && export SSH_AUTH_SOCK="$sock" && break
done

# --- Secrets rendered from Bitwarden ---------------------------------------
[[ -r "$HOME/.config/zsh/secrets.zsh" ]] && source "$HOME/.config/zsh/secrets.zsh"
{{- end }}

# --- Aliases ---------------------------------------------------------------
alias cz='chezmoi'
alias ll='ls -lah --color=auto'

[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
